[Desktop Entry]
Version=1.0
Name=Shellvane
Comment=SSH, SFTP and tunnel manager
# The Exec line includes %u to pass the URL to the application
Exec=/usr/local/bin/shellvane %u
Terminal=false
Type=Application
Icon=shellvane
Categories=Utility;
StartupWMClass=shellvane
MimeType=x-scheme-handler/ssh;x-scheme-handler/sftp;
